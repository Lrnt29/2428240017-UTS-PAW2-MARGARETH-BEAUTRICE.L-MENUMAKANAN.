{
  "info": {
    "name": "UTS PAW 2 - Menu Makanan (2428240017)",
    "description": "REST API Manajemen Menu Makanan: CRUD, filter, sorting, dan pagination.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "POST - Tambah menu 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/menumakanan",
          "host": ["{{baseUrl}}"],
          "path": ["api", "menumakanan"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Pindang Ikan Patin\",\n  \"description\": \"Ikan patin dengan kuah bercita rasa khas Palembang\",\n  \"price\": 50000,\n  \"is_available\": true\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('id', pm.response.json().data._id);"
            ]
          }
        }
      ]
    },
